# ANTHROPIC_API_KEY: Required for Claude AI API calls (get one at https://platform.claude.com).
# Set this in a .env file locally, or as an environment variable / secret on your hosting service.
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# KEY_ENCRYPTION_SECRET: A long random password (at least 16 characters) used to encrypt
# the Claude API keys committee members save in the AI Settings tab. Keep it secret, and
# don't change it later, or saved keys can no longer be read and must be added again.
KEY_ENCRYPTION_SECRET="MY_KEY_ENCRYPTION_SECRET"
